# Copy to .env and put your local Postgres password in place of <password>.
# Both variables are required (Prisma reads DIRECT_URL for migrations).

# Local development: a PostgreSQL database on this machine.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/pigment_erp?schema=public"
DIRECT_URL="postgresql://postgres:<password>@localhost:5432/pigment_erp?schema=public"

# Production (Neon): DATABASE_URL is the pooled (-pooler) connection string,
# DIRECT_URL the direct one, e.g.
# DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/pigment_erp?sslmode=require"
# DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/pigment_erp?sslmode=require"
